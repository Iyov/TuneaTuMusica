# Configuración de TuneaTuMusica
# ================================
# Copia este archivo como .env y completa tus credenciales

# ========================================
# API Key de AcoustID (REQUERIDA)
# ========================================
# Esta API es necesaria para identificar canciones por huella digital
# 1. Visita: https://acoustid.org/
# 2. Crea una cuenta gratuita
# 3. Ve a "Applications" y crea una nueva aplicación
# 4. Copia tu API Key aquí
ACOUSTID_API_KEY=tu_api_key_aqui

# ========================================
# Credenciales de MusicBrainz (OPCIONAL)
# ========================================
# MusicBrainz es una base de datos de música abierta
# Las credenciales son opcionales pero mejoran los resultados
# Registrate en: https://musicbrainz.org/register
MUSICBRAINZ_USER=
MUSICBRAINZ_PASSWORD=

# ========================================
# API Key de OpenAI (OPCIONAL)
# ========================================
# Usado como fallback cuando AcoustID no puede identificar una canción
# 1. Visita: https://platform.openai.com/api-keys
# 2. Crea una cuenta o inicia sesión
# 3. Genera una nueva API Key
# 4. Copia la key aquí (comienza con sk-)
OPENAI_API_KEY=
IA_ENABLED=false

# ========================================
# Notas:
# ========================================
# - Solo ACOUSTID_API_KEY es obligatoria
# - OpenAI es opcional pero útil para archivos difíciles de identificar
# - Cambia IA_ENABLED=true para activar el fallback con IA
# - Nunca compartas este archivo con tus API keys reales
